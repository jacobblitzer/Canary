<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Canary.Agent.Rhino</RootNamespace>
    <AssemblyName>Canary.Agent.Rhino</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.15.25013.13001" IncludeAssets="compile" />
    <PackageReference Include="RhinoCommon" Version="8.15.25013.13001" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Canary.Agent\Canary.Agent.csproj" />
  </ItemGroup>

  <!-- Auto-deploy to Rhino 8 user plugin directory after build -->
  <PropertyGroup>
    <RhinoPluginDir>$(APPDATA)\McNeel\Rhinoceros\8.0\Plug-ins\Canary (B4E7C920-3A1F-4D00-B800-CA0A4700A001)</RhinoPluginDir>
  </PropertyGroup>

  <Target Name="DeployToRhino" AfterTargets="Build" Condition="Exists('$(APPDATA)\McNeel\Rhinoceros\8.0\Plug-ins')">
    <MakeDir Directories="$(RhinoPluginDir)" />
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RhinoPluginDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed Canary agent to $(RhinoPluginDir)" />
  </Target>

  <!-- Ship the net48 agent to the Drive payload.
       PAYLOAD-CORRUPTION FIX (Phase 2 recon 2026-08-16, root cause of the
       machine-2 "canary.exe cannot parse any JSON" incident): this target
       used to copy $(TargetDir)**\*.* into the payload ROOT — the same
       folder the net8.0 harness publishes into. The net48 closure carries
       System.Text.Json.dll, System.Text.Encodings.Web.dll,
       System.IO.Pipelines.dll and Canary.Agent.dll under IDENTICAL names,
       so every build overwrote the harness's net8.0 assemblies with .NET
       Framework ones. The payload then demanded Microsoft.Bcl.AsyncInterfaces
       (a net462-only dependency) and threw on the first deserialization
       while the help command still worked. The deps.json was never wrong; the DLLs
       beside it were from the other framework.
       Two changes keep that impossible: the agent lands in its OWN subfolder,
       and shipping is OPT-IN (scripts/publish-payload.ps1 sets it) so a
       routine `dotnet build` can no longer rewrite a published payload. -->
  <Target Name="ShipToDrive" AfterTargets="Build"
          Condition="'$(CanaryShipToDrive)' == 'true' And Exists('G:\My Drive\Builds')">
    <ItemGroup>
      <ShipFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <MakeDir Directories="G:\My Drive\Builds\Canary\agent" />
    <Copy SourceFiles="@(ShipFiles)"
          DestinationFiles="@(ShipFiles->'G:\My Drive\Builds\Canary\agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[ship] Canary.Agent.Rhino.rhp + net48 deps -> G:\My Drive\Builds\Canary\agent" />
  </Target>

</Project>
