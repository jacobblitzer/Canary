{
  "name": "qualia-web",
  "displayName": "Qualia (Deployed Web — vite preview)",
  "appPath": "npm.cmd",
  "appArgs": "run preview",
  "agentType": "qualia-cdp",
  "pipeName": "canary-qualia-web",
  "startupTimeoutMs": 30000,
  "windowTitle": "Qualia",
  "viewportClass": "",
  "qualiaConfig": {
    "projectDir": "%CANARY_REPO_QUALIA%",
    "chromePath": "",
    "cdpPort": 9225,
    "vitePort": 4173,
    "viteScript": "preview",
    "defaultCanvasWidth": 1280,
    "defaultCanvasHeight": 720,
    "defaultStabilizeMs": 500,
    "readyTimeoutSec": 30,
    "clearLocalStorageOnInit": true,
    "chromeFlags": [
      "--force-device-scale-factor=1",
      "--hide-scrollbars",
      "--disable-smooth-scrolling"
    ]
  },
  "requires": [
    {
      "kind": "plugin",
      "id": "js:__canaryWaitForReady",
      "fix": "the Qualia page did not install its Canary hooks (packages/ui/src/canary-hooks.ts) - check the app actually built and is being served, not a stale dist"
    }
  ]
}
