{
    "name": "cpig-79-penumbra-fixture",
    "workload": "rhino",
    "description": "79 Penumbra Fixture (R6.5 Phase E2 — the canary for the whole Penumbra-Preview lane). ONE tape sphere → CPig_PenumbraPreview. Smallest thing that can possibly render. Warm-up test for the field matrix — runs first in the suite to cold-compile shaders at the test viewport size.",
    "runMode": "shared",
    "setup": {
        "file": "fixtures/cpig_slop_loader.gh",
        "viewport": { "projection": "Perspective", "displayMode": "Shaded", "width": 800, "height": 600 },
        "vlm": { "provider": "ollama", "model": "qwen2.5vl:7b" },
        "vlmDescription": "A 3D ray-marched SDF surface drawn into the Rhino viewport: a single SMOOTH SPHERE — one solid round ball with a continuous, unbroken, shaded surface. Must NOT be empty/grey. Must NOT be a lattice or porous structure."
    },
    "actions": [
        { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
        { "type": "GrasshopperSetToggle", "nickname": "Build", "value": false },
        { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": true },
        { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
        { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": false },
        { "type": "WaitForGrasshopperSolution", "timeoutMs": 2000 },
        { "type": "GrasshopperSetPanelText", "nickname": "JsonPath", "text": "C:/Repos/CPig/research/slop_tests/79_penumbra_fixture.json" },
        { "type": "RunCommand", "command": "_PenumbraPreviewBackend _Glsl" },
        { "type": "GrasshopperSetToggle", "nickname": "Build", "value": true },
        { "type": "WaitForGrasshopperSolution", "timeoutMs": 60000 },
        { "type": "WaitForPenumbraFrame", "requireReal": true, "minRevision": 1, "timeoutMs": 110000 },
        { "type": "RunCommand", "command": "-_4View _Enter" },
        { "type": "RunCommand", "command": "-_MaxViewport" },
        { "type": "RunCommand", "command": "-_SetView _World _Perspective" },
        { "type": "RunCommand", "command": "-_Sphere 0,0,0 400" },
        { "type": "RunCommand", "command": "_SelNone" },
        { "type": "RunCommand", "command": "_SelLast" },
        { "type": "RunCommand", "command": "-_Zoom _Selected" },
        { "type": "RunCommand", "command": "-_ViewportProperties _Lens 35 _EnterEnd" },
        { "type": "RunCommand", "command": "-_ViewportProperties _Lens 50 _EnterEnd" },
        { "type": "RunCommand", "command": "_Delete" },
        { "type": "WaitForPenumbraFrame", "requireReal": true, "requireSteady": true, "timeoutMs": 90000 }
    ],
    "checkpoints": [
        {
            "name": "penumbra-fixture-sphere",
            "atTimeMs": 0,
            "source": "viewport",
            "mode": "capture",
            "stabilizeMs": 1500,
            "tolerance": 0.05
        }
    ],
    "asserts": [
        { "type": "PanelEquals", "nickname": "SlopSuccess", "text": "True" },
        { "type": "PanelDoesNotContain", "nickname": "SlopLog", "text": "FATAL" },
        { "type": "PanelContains", "nickname": "Status", "text": "Pushed" },
        { "type": "PanelEquals", "nickname": "Connected", "text": "True" }
    ]
}