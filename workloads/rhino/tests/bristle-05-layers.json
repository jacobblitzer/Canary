{
 "name": "bristle-05-layers",
 "workload": "rhino",
 "description": "Bristle 05 \u2014 R2 return surface: analyze the egg (regions ON), then BR_Regions / BR_Contours / BR_FetchLayers pull borders, iso-curves, and layer data back into GH. PREREQ: live R2 engine (see spec/BRISTLE_WORKLOAD.md).",
 "setup": {
  "file": "fixtures/bristle_slop_loader.gh",
  "viewport": {
   "width": 800,
   "height": 600,
   "projection": "Perspective",
   "displayMode": "Shaded"
  },
  "commands": [],
  "scene": null,
  "backend": "",
  "canvas": null,
  "vlm": null
 },
 "runMode": "shared",
 "recording": "",
 "checkpoints": [
  {
   "name": "canvas-state",
   "source": "viewport",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "GH canvas after harvest (save-only; asserts carry the gate)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  }
 ],
 "actions": [
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": false
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": false
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  },
  {
   "type": "GrasshopperSetPanelText",
   "nickname": "JsonPath",
   "text": "C:/Repos/Bristle/tests/slop/05_bristle_layers.json"
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 30000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Run",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "BristleState",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 90000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Harvest",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "RegionsLog",
   "text": "fetched",
   "mode": "contains",
   "timeoutMs": 20000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  }
 ],
 "asserts": [
  {
   "type": "PanelDoesNotContain",
   "nickname": "ConnStatus",
   "text": "OFFLINE",
   "description": "engine reachable (prereq: R2 service running)"
  },
  {
   "type": "PanelContains",
   "nickname": "RegionsLog",
   "text": "regions fetched",
   "description": "SAM region borders arrived in GH as curves"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "RegionsLog",
   "text": "0 regions",
   "description": "the egg must segment into at least one region"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "RegionsLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "ContoursLog",
   "text": "curves from values",
   "description": "iso-contours of the values layer arrived as curves"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "ContoursLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "LayersLog",
   "text": "layer values",
   "description": "layer fetch round-tripped (bitmap + manifest)"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "LayersLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelEquals",
   "nickname": "SlopSuccess",
   "text": "True",
   "description": ""
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "SlopLog",
   "text": "FATAL",
   "description": ""
  }
 ],
 "keepOpenOnFailure": false
}
