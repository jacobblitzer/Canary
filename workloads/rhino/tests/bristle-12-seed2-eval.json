{
  "name": "bristle-12-seed2-eval",
  "workload": "rhino",
  "description": "SEED-2 EVALUATION canvas (keep-open, absent from every suite): every region is filled as a surface coloured by the SEED GROUP that produced it, grey where seed_group is -1 (leftover, found without a seed), over the dimmed photo. Lets both the operator and the agent judge coverage, overlap and whether children are sensible - from the picture, not just counts. Uses only native GH components (Boundary Surfaces / Evaluate / Colour HSL / Graft Tree / Custom Preview).",
  "setup": {
    "file": "fixtures/bristle_slop_loader.gh",
    "viewport": {
      "width": 1400,
      "height": 1000,
      "projection": "Top",
      "displayMode": "Shaded"
    },
    "commands": [],
    "scene": null,
    "backend": "",
    "canvas": null,
    "vlm": null
  },
  "runMode": "shared",
  "recording": "",
  "checkpoints": [
    {
      "name": "seed2-eval-fills",
      "source": "viewport",
      "atTimeMs": 0,
      "tolerance": 0.0,
      "description": "Top view: coloured region fills over the photo - the artifact the ruling is made from",
      "mode": "capture",
      "camera": null,
      "stabilizeMs": 1200
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_BRISTLE%/tests/slop/12_bristle_seed2_eval.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 40000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "AnalysisJSON",
      "text": "\"enabled\":true",
      "mode": "contains",
      "timeoutMs": 20000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Run",
      "value": true
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "JobState",
      "text": "done",
      "mode": "equals",
      "timeoutMs": 900000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Fetch",
      "value": true
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "RegionCount",
      "text": "fetched",
      "mode": "contains",
      "timeoutMs": 120000
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 20000
    },
    {
      "type": "SetView",
      "name": "Top"
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    }
  ],
  "asserts": [
    {
      "type": "PanelDoesNotContain",
      "nickname": "ConnStatus",
      "text": "OFFLINE",
      "description": "engine reachable"
    },
    {
      "type": "PanelContains",
      "nickname": "RegionCount",
      "text": "regions fetched",
      "description": "the region tree came home"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "Coverage",
      "text": "0.0",
      "description": "the fills actually cover something - a zero coverage means Boundary Surfaces produced nothing"
    },
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": "every native component resolved and wired"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "Error",
      "description": ""
    }
  ],
  "keepOpenOnFailure": true,
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "plugin",
      "id": "gh:Bristle",
      "fix": "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_BRISTLE%/tests/slop/12_bristle_seed2_eval.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
    }
  ]
}
