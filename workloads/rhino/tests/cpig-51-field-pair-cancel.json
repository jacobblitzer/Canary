{
    "name": "cpig-51-field-pair-cancel",
    "workload": "rhino",
    "description": "51 Field Pair Cancel (auto-generated from 51_field_pair_cancel.json)",
    "runMode": "shared",
    "setup": {
        "file": "fixtures/cpig_slop_loader.gh",
        "viewport": {
            "projection": "Perspective",
            "displayMode": "Shaded",
            "width": 800,
            "height": 600
        },
        "commands": [],
        "vlm": {
            "provider": "ollama",
            "model": "gemma4:e2b"
        },
        "vlmDescription": "A triangulated sphere with motorcycle separatrix arcs drawn over it, similar to test 40. After pair cancellation there may be fewer arcs, but the visual difference can be subtle \u2014 the key invariant is that arcs (curve overlays on the sphere) are present."
    },
    "actions": [
        {
            "type": "WaitForGrasshopperSolution",
            "timeoutMs": 5000
        },
        {
            "type": "GrasshopperSetToggle",
            "nickname": "Build",
            "value": false
        },
        {
            "type": "GrasshopperSetToggle",
            "nickname": "Cleanup",
            "value": true
        },
        {
            "type": "WaitForGrasshopperSolution",
            "timeoutMs": 5000
        },
        {
            "type": "GrasshopperSetToggle",
            "nickname": "Cleanup",
            "value": false
        },
        {
            "type": "WaitForGrasshopperSolution",
            "timeoutMs": 2000
        },
        {
            "type": "GrasshopperSetPanelText",
            "nickname": "JsonPath",
            "text": "%CANARY_REPO_CPIG%/research/slop_tests/51_field_pair_cancel.json"
        },
        {
            "type": "GrasshopperSetToggle",
            "nickname": "Build",
            "value": true
        },
        {
            "type": "WaitForGrasshopperSolution",
            "timeoutMs": 60000
        }
    ],
    "checkpoints": [
        {
            "name": "post-build",
            "atTimeMs": 5000,
            "tolerance": 0.02
        }
    ],
    "asserts": [
        {
            "type": "PanelEquals",
            "nickname": "SlopSuccess",
            "text": "True"
        },
        {
            "type": "PanelDoesNotContain",
            "nickname": "SlopLog",
            "text": "FATAL"
        },
        {
            "type": "PanelDoesNotContain",
            "nickname": "SlopLog",
            "text": "!!!"
        }
    ],
    "requires": [
        {
            "kind": "plugin",
            "id": "gh:Slop",
            "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
        },
        {
            "kind": "plugin",
            "id": "gh:CPig",
            "fix": "install the CPig yak package, or on a dev machine build %CANARY_REPO_CPIG% CPig.Grasshopper (net48) and register its output folder in Grasshopper Developer Settings"
        },
        {
            "kind": "file",
            "path": "%CANARY_REPO_CPIG%/research/slop_tests/51_field_pair_cancel.json",
            "fix": "this test loads a Slop definition from the CANARY_REPO_CPIG repo; check that repo out and point %CANARY_REPO_CPIG% at it (see workloads/tokens.json)"
        }
    ]
}
