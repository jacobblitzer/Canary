{
 "name": "bristle-sweep-facade-brick-no-crosshatch",
 "workload": "rhino",
 "description": "Sweep facade-brick/no-crosshatch: parallel-only hatching, no interleave. Full pipeline to preview + StrokeSet + .3dm.",
 "setup": {
  "file": "fixtures/bristle_slop_loader.gh",
  "viewport": {
   "width": 800,
   "height": 600,
   "projection": "Perspective",
   "displayMode": "Shaded"
  },
  "commands": [],
  "scene": null,
  "backend": "",
  "canvas": null,
  "vlm": null
 },
 "runMode": "shared",
 "recording": "",
 "checkpoints": [
  {
   "name": "preview",
   "source": "file",
   "filePath": "%CANARY_REPO_BRISTLE%/out/sweeps/facade-brick/no-crosshatch/preview.png",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "sweep artifact: parallel-only hatching, no interleave",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  },
  {
   "name": "toolpath",
   "source": "file",
   "filePath": "%CANARY_HANDOFF%/Plotline/PlotFiles/sweeps/facade-brick/no-crosshatch.3dm",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "sweep artifact: parallel-only hatching, no interleave",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  }
 ],
 "actions": [
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": false
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": false
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  },
  {
   "type": "GrasshopperSetPanelText",
   "nickname": "JsonPath",
   "text": "%CANARY_REPO_BRISTLE%/tests/slop/sweeps/facade-brick-no-crosshatch.json"
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 30000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Run",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "BristleState",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 60000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Fetch",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 20000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Export",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "ExportLog",
   "text": "exported",
   "mode": "contains",
   "timeoutMs": 15000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  }
 ],
 "asserts": [
  {
   "type": "PanelEquals",
   "nickname": "BristleState",
   "text": "done",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "ExportLog",
   "text": "pen layer",
   "description": ""
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "ExportLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelEquals",
   "nickname": "SlopSuccess",
   "text": "True",
   "description": ""
  }
 ],
 "keepOpenOnFailure": false,
 "requires": [
  {
   "kind": "plugin",
   "id": "gh:Slop",
   "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
  },
  {
   "kind": "plugin",
   "id": "gh:Bristle",
   "fix": "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
  },
  {
   "kind": "file",
   "path": "%CANARY_REPO_BRISTLE%/tests/slop/sweeps/facade-brick-no-crosshatch.json",
   "fix": "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
  }
 ]
}
