{
 "workload": "rhino",
 "setup": {
  "file": "fixtures/bristle_slop_loader.gh",
  "viewport": {
   "width": 800,
   "height": 600,
   "projection": "Perspective",
   "displayMode": "Shaded"
  },
  "commands": [],
  "scene": null,
  "backend": "",
  "canvas": null,
  "vlm": null
 },
 "runMode": "shared",
 "recording": "",
 "checkpoints": [
  {
   "name": "canvas-state",
   "source": "viewport",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "showcase canvas (save-only)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  },
  {
   "name": "topo-3dm",
   "source": "file",
   "filePath": "%CANARY_HANDOFF%/Plotline/PlotFiles/sunflower-topo.3dm",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "depth topo-bands as a plot file",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  }
 ],
 "keepOpenOnFailure": false,
 "name": "bristle-07-harvest-showcase",
 "description": "R2 showcase: the sunflower harvested four ways (value iso-contours, depth topo-bands, flow streamlines, saliency peaks) and the depth topo EXPORTED to the PlotFiles pickup as a plot file. PREREQ: live R2 engine + G: mounted.",
 "actions": [
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": false
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": false
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  },
  {
   "type": "GrasshopperSetPanelText",
   "nickname": "JsonPath",
   "text": "%CANARY_REPO_BRISTLE%/tests/slop/07_bristle_harvest_showcase.json"
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 30000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Run",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "BristleState",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 120000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Harvest",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "IsoLog",
   "text": "curves",
   "mode": "contains",
   "timeoutMs": 30000
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "BandLog",
   "text": "curves",
   "mode": "contains",
   "timeoutMs": 30000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Plot",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "ExportLog",
   "text": "pen layer",
   "mode": "contains",
   "timeoutMs": 20000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  }
 ],
 "asserts": [
  {
   "type": "PanelDoesNotContain",
   "nickname": "ConnStatus",
   "text": "OFFLINE",
   "description": "engine reachable"
  },
  {
   "type": "PanelContains",
   "nickname": "IsoLog",
   "text": "curves from values",
   "description": "value iso-contours as curves"
  },
  {
   "type": "PanelContains",
   "nickname": "BandLog",
   "text": "curves from depth",
   "description": "depth topo-bands as curves"
  },
  {
   "type": "PanelContains",
   "nickname": "StreamLog",
   "text": "streamlines",
   "description": "flow field as curves"
  },
  {
   "type": "PanelContains",
   "nickname": "PeaksLog",
   "text": "points",
   "description": "saliency peaks as points"
  },
  {
   "type": "PanelContains",
   "nickname": "ExportLog",
   "text": "pen layer",
   "description": "the topo landed in PlotFiles as a plottable .3dm"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "ExportLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelEquals",
   "nickname": "SlopSuccess",
   "text": "True",
   "description": ""
  }
 ],
 "requires": [
  {
   "kind": "plugin",
   "id": "gh:Slop",
   "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
  },
  {
   "kind": "plugin",
   "id": "gh:Bristle",
   "fix": "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
  },
  {
   "kind": "file",
   "path": "%CANARY_REPO_BRISTLE%/tests/slop/07_bristle_harvest_showcase.json",
   "fix": "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
  }
 ]
}
