{
  "name": "lightro-03-aperture",
  "workload": "rhino",
  "description": "03 Authored Aperture \u2014 a Circle curve shapes the 9x9 aperture weights (LF Aperture) feeding LF Refocus; the computed bokeh image is the artifact.",
  "setup": {
    "file": "fixtures/lightro_slop_loader.gh",
    "viewport": {
      "width": 800,
      "height": 600,
      "projection": "Perspective",
      "displayMode": "Shaded"
    },
    "commands": []
  },
  "runMode": "shared",
  "checkpoints": [
    {
      "name": "aperture-refocus",
      "source": "file",
      "panelNickname": "RefocusFilePath",
      "tolerance": 0.05,
      "description": "refocus through the curve-authored aperture (weights from a circle of radius 0.7)",
      "mode": "capture"
    }
  ],
  "actions": [
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
    { "type": "GrasshopperSetToggle", "nickname": "Build", "value": false },
    { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": true },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
    { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": false },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 2000 },
    { "type": "GrasshopperSetPanelText", "nickname": "JsonPath",
      "text": "C:/Repos/Lightro/tests/slop/03_authored_aperture.json" },
    { "type": "GrasshopperSetToggle", "nickname": "Build", "value": true },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 60000 }
  ],
  "asserts": [
    { "type": "PanelEquals", "nickname": "SlopSuccess", "text": "True", "description": "Slop build succeeded" },
    { "type": "PanelDoesNotContain", "nickname": "SlopLog", "text": "FATAL", "description": "" },
    { "type": "PanelDoesNotContain", "nickname": "SlopLog", "text": "not found", "description": "" },
    { "type": "PanelContains", "nickname": "ApertureInfo", "text": "views active", "description": "authored weights computed" },
    { "type": "PanelContains", "nickname": "RefocusFilePath", "text": "refocus_a", "description": "bokeh image saved" }
  ],
  "keepOpenOnFailure": true
}
