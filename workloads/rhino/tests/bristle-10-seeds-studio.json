{
  "name": "bristle-10-seeds-studio",
  "workload": "rhino",
  "description": "OPERATOR STUDIO for SEED-2 ratification, not a gate test (deliberately absent from suites): builds the seeds studio canvas (market backdrop + max+seeds analyze with per-source toggles + seeds-only fast Mode + region TREE fetch + BR_SeedView with mode picker), runs one full round trip, and hands Rhino to the operator. Run with --test and NO --headless so the app stays open for fiddling.",
  "setup": {
    "file": "fixtures/bristle_slop_loader.gh",
    "viewport": {
      "width": 800,
      "height": 600,
      "projection": "Perspective",
      "displayMode": "Shaded"
    },
    "commands": [],
    "scene": null,
    "backend": "",
    "canvas": null,
    "vlm": null
  },
  "runMode": "shared",
  "recording": "",
  "checkpoints": [
    {
      "name": "seeds-studio-ready",
      "source": "viewport",
      "atTimeMs": 0,
      "tolerance": 0.0,
      "description": "Backdrop + tree borders + seed overlay landed (save-only; the studio is interactive from here)",
      "mode": "capture",
      "camera": null,
      "stabilizeMs": null
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "C:/Repos/Bristle/tests/slop/10_bristle_seeds_studio.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 30000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "AnalysisJSON",
      "text": "\"level\":\"max\"",
      "mode": "contains",
      "timeoutMs": 20000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Run",
      "value": true
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "FullState",
      "text": "done",
      "mode": "equals",
      "timeoutMs": 600000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Fetch",
      "value": true
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "RegionsLog",
      "text": "fetched",
      "mode": "contains",
      "timeoutMs": 60000
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    }
  ],
  "asserts": [
    {
      "type": "PanelDoesNotContain",
      "nickname": "ConnStatus",
      "text": "OFFLINE",
      "description": "engine reachable (prereq: service running)"
    },
    {
      "type": "PanelContains",
      "nickname": "AnalysisJSON",
      "text": "bind_max_gap_px",
      "description": "the sliders assemble a complete AnalysisParams JSON"
    },
    {
      "type": "PanelContains",
      "nickname": "AnalysisJSON",
      "text": "\"sources\":[",
      "description": "the six source toggles assemble the seeds.sources array (Cull Pattern -> Text Join lane)"
    },
    {
      "type": "PanelContains",
      "nickname": "AnalysisJSON",
      "text": "\"regions\":{\"enabled\":true",
      "description": "Mode valuelist default = full job; the fragment chain closes valid JSON"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SubmitLog",
      "text": "not valid JSON",
      "description": "the assembled JSON survived the engine door"
    },
    {
      "type": "PanelContains",
      "nickname": "RegionsLog",
      "text": "regions fetched",
      "description": "the tree + seeds round trip landed before the operator touches anything"
    },
    {
      "type": "PanelContains",
      "nickname": "SeedLog",
      "text": "seeds in",
      "description": "BR_SeedView staged the seed overlay (N seeds in G groups)"
    },
    {
      "type": "PanelContains",
      "nickname": "BackdropLog",
      "text": "backdrop staged",
      "description": "the photo is under the overlay"
    },
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": ""
    }
  ],
  "keepOpenOnFailure": true
}