{
  "name": "lightro-02-viewpoints",
  "workload": "rhino",
  "description": "02 LF Viewpoints \u2014 the axis-flip tripwire as a standing regression test: corner view (-1,-1) vs (+1,+1) must each match their own baseline.",
  "setup": {
    "file": "fixtures/lightro_slop_loader.gh",
    "viewport": {
      "width": 800,
      "height": 600,
      "projection": "Perspective",
      "displayMode": "Shaded"
    },
    "commands": []
  },
  "runMode": "shared",
  "checkpoints": [
    {
      "name": "view-corner-neg",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0007/_gh/view_x-1.00_y-1.00.png",
      "tolerance": 0.05,
      "description": "sub-aperture corner view at (-1,-1)",
      "mode": "capture"
    },
    {
      "name": "view-corner-pos",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0007/_gh/view_x+1.00_y+1.00.png",
      "tolerance": 0.05,
      "description": "sub-aperture corner view at (+1,+1) \u2014 if axes ever flip, these two swap and pixel-diff catches it",
      "mode": "capture"
    }
  ],
  "actions": [
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
    { "type": "GrasshopperSetToggle", "nickname": "Build", "value": false },
    { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": true },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 5000 },
    { "type": "GrasshopperSetToggle", "nickname": "Cleanup", "value": false },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 2000 },
    { "type": "GrasshopperSetPanelText", "nickname": "JsonPath",
      "text": "%CANARY_REPO_LIGHTRO%/tests/slop/02_viewpoints.json" },
    { "type": "GrasshopperSetToggle", "nickname": "Build", "value": true },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 60000 },
    { "type": "GrasshopperSetSlider", "nickname": "ViewX", "value": -1 },
    { "type": "GrasshopperSetSlider", "nickname": "ViewY", "value": -1 },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 30000 },
    { "type": "GrasshopperSetSlider", "nickname": "ViewX", "value": 1 },
    { "type": "GrasshopperSetSlider", "nickname": "ViewY", "value": 1 },
    { "type": "WaitForGrasshopperSolution", "timeoutMs": 30000 }
  ],
  "asserts": [
    { "type": "PanelEquals", "nickname": "SlopSuccess", "text": "True", "description": "Slop build succeeded" },
    { "type": "PanelDoesNotContain", "nickname": "SlopLog", "text": "FATAL", "description": "" },
    { "type": "PanelDoesNotContain", "nickname": "SlopLog", "text": "not found", "description": "" },
    { "type": "PanelContains", "nickname": "ViewFilePath", "text": "view_x", "description": "view PNG saved" }
  ],
  "keepOpenOnFailure": true,
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_LIGHTRO%/tests/slop/02_viewpoints.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_LIGHTRO repo; check that repo out and point %CANARY_REPO_LIGHTRO% at it (see workloads/tokens.json)"
    },
    {
      "kind": "plugin",
      "id": "gh:Lightro.Components",
      "fix": "install the Lightro Grasshopper components (Lightro.Components.gha) into the Grasshopper Libraries folder; on a dev machine build the rhproj in %CANARY_REPO_LIGHTRO%"
    }
]
}
