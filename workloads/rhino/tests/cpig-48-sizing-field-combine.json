{
  "name": "cpig-48-sizing-field-combine",
  "workload": "rhino",
  "description": "48 Sizing Field Combine (auto-generated from 48_sizing_field_combine.json)",
  "setup": {
    "file": "fixtures/cpig_slop_loader.gh",
    "viewport": {
      "width": 800,
      "height": 600,
      "projection": "Perspective",
      "displayMode": "Shaded"
    },
    "commands": [],
    "scene": null,
    "backend": "",
    "canvas": null,
    "vlm": {
      "provider": "ollama",
      "model": "gemma4:e2b",
      "maxTokens": 1024
    }
  },
  "runMode": "shared",
  "recording": "",
  "checkpoints": [
    {
      "name": "post-build",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "description": "",
      "source": "viewport",
      "panelNickname": null,
      "mode": "pixel-diff",
      "camera": null,
      "stabilizeMs": null
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_CPIG%/research/slop_tests/48_sizing_field_combine.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    }
  ],
  "asserts": [
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": ""
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "FATAL",
      "description": ""
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "!!!",
      "description": ""
    }
  ],
  "keepOpenOnFailure": false,
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "plugin",
      "id": "gh:CPig",
      "fix": "install the CPig yak package, or on a dev machine build %CANARY_REPO_CPIG% CPig.Grasshopper (net48) and register its output folder in Grasshopper Developer Settings"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_CPIG%/research/slop_tests/48_sizing_field_combine.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_CPIG repo; check that repo out and point %CANARY_REPO_CPIG% at it (see workloads/tokens.json)"
    }
  ]
}