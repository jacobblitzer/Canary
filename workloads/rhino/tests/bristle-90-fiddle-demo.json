{
  "name": "bristle-90-fiddle-demo",
  "workload": "rhino",
  "description": "OPERATOR DEMO, not a gate test (deliberately absent from suites/bristle.json): builds the S1 fiddle canvas (BR_Style sliders -> BR_Preview auto-draft + a full-quality BR_Submit/Fetch lane) and hands Rhino to the operator. Run with --test and NO --headless so the app stays open for fiddling.",
  "setup": {
    "file": "fixtures/bristle_slop_loader.gh",
    "viewport": {
      "width": 800,
      "height": 600,
      "projection": "Perspective",
      "displayMode": "Shaded"
    },
    "commands": [],
    "scene": null,
    "backend": "",
    "canvas": null,
    "vlm": null
  },
  "runMode": "shared",
  "recording": "",
  "checkpoints": [
    {
      "name": "fiddle-canvas-ready",
      "source": "viewport",
      "atTimeMs": 0,
      "tolerance": 0.0,
      "description": "Canvas built + first draft landed (save-only; the demo is interactive from here)",
      "mode": "capture",
      "camera": null,
      "stabilizeMs": null
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "C:/Repos/Bristle/tests/slop/90_bristle_fiddle_demo.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 30000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "PrevReport",
      "text": "draft",
      "mode": "contains",
      "timeoutMs": 30000
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    }
  ],
  "asserts": [
    {
      "type": "PanelDoesNotContain",
      "nickname": "ConnStatus",
      "text": "OFFLINE",
      "description": "engine reachable (prereq: service running)"
    },
    {
      "type": "PanelContains",
      "nickname": "PrevReport",
      "text": "draft",
      "description": "first auto-draft landed - the loop is live before the operator touches anything"
    },
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": ""
    }
  ],
  "keepOpenOnFailure": true
}
