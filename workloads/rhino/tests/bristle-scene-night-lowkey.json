{
 "name": "bristle-scene-night-lowkey",
 "workload": "rhino",
 "description": "Scene gallery: night-lowkey - low-key extreme: the tonal ladder must not mud out. Full pipeline: auto-draft preview -> full run -> fetch -> BR_Export .3dm (the Plotline handoff). PREREQ: live engine (see spec/BRISTLE_WORKLOAD.md).",
 "setup": {
  "file": "fixtures/bristle_slop_loader.gh",
  "viewport": {
   "width": 800,
   "height": 600,
   "projection": "Perspective",
   "displayMode": "Shaded"
  },
  "commands": [],
  "scene": null,
  "backend": "",
  "canvas": null,
  "vlm": null
 },
 "runMode": "shared",
 "recording": "",
 "checkpoints": [
  {
   "name": "strokeset",
   "source": "file",
   "filePath": "%CANARY_REPO_BRISTLE%/out/scenes/night-lowkey/strokes.v0.json",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "scene-gallery artifact (save-only; blessable later)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  },
  {
   "name": "plotline-3dm",
   "source": "file",
   "filePath": "%CANARY_HANDOFF%/Plotline/PlotFiles/night-lowkey.3dm",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "scene-gallery artifact (save-only; blessable later)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  },
  {
   "name": "engine-preview",
   "source": "file",
   "filePath": "%CANARY_REPO_BRISTLE%/out/scenes/night-lowkey/preview.png",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "scene-gallery artifact (save-only; blessable later)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  }
 ],
 "actions": [
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": false
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": false
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  },
  {
   "type": "GrasshopperSetPanelText",
   "nickname": "JsonPath",
   "text": "%CANARY_REPO_BRISTLE%/tests/slop/scenes/night-lowkey.json"
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 30000
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "PrevReport",
   "text": "draft",
   "mode": "contains",
   "timeoutMs": 30000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Run",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "BristleState",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 60000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Fetch",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 20000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Export",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "ExportLog",
   "text": "exported",
   "mode": "contains",
   "timeoutMs": 15000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  }
 ],
 "asserts": [
  {
   "type": "PanelDoesNotContain",
   "nickname": "ConnStatus",
   "text": "OFFLINE",
   "description": "engine reachable"
  },
  {
   "type": "PanelContains",
   "nickname": "PrevReport",
   "text": "draft",
   "description": "auto-draft preview landed before the full run"
  },
  {
   "type": "PanelEquals",
   "nickname": "BristleState",
   "text": "done",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "ViewLegend",
   "text": "]",
   "description": "BR_StrokeView staged the strokes with kind profiles (legend non-empty)"
  },
  {
   "type": "PanelContains",
   "nickname": "ExportLog",
   "text": "pen layer",
   "description": ".3dm written with pen layers - the Plotline handoff exists"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "ExportLog",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelEquals",
   "nickname": "SlopSuccess",
   "text": "True",
   "description": ""
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "SlopLog",
   "text": "FATAL",
   "description": ""
  }
 ],
 "keepOpenOnFailure": false,
 "requires": [
  {
   "kind": "plugin",
   "id": "gh:Slop",
   "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
  },
  {
   "kind": "plugin",
   "id": "gh:Bristle",
   "fix": "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
  },
  {
   "kind": "file",
   "path": "%CANARY_REPO_BRISTLE%/tests/slop/scenes/night-lowkey.json",
   "fix": "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
  }
 ]
}
