{
  "name": "lightro-05-rays",
  "workload": "rhino",
  "description": "05 LF Rays \u2014 the light-ray viewing modes as a compiled component. A RayModeIndex slider scrubs all 19 modes; the test visits depth / view-dependence / contact-sheet / ray-fan and compares each computed image (file-source).",
  "setup": {
    "file": "fixtures/lightro_slop_loader.gh",
    "viewport": {
      "width": 1000,
      "height": 700,
      "projection": "Top",
      "displayMode": "Shaded"
    },
    "commands": []
  },
  "runMode": "shared",
  "checkpoints": [
    {
      "name": "rays-depth",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0011/_gh/rays_depth.png",
      "tolerance": 0.05,
      "description": "relative distance from parallax",
      "mode": "capture"
    },
    {
      "name": "rays-view-dependence",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0011/_gh/rays_view-dependence.png",
      "tolerance": 0.05,
      "description": "what still changes after depth alignment = view-dependent light",
      "mode": "capture"
    },
    {
      "name": "rays-contact-sheet",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0011/_gh/rays_contact-sheet.png",
      "tolerance": 0.05,
      "description": "all 81 sub-aperture views tiled \u2014 the light field as itself",
      "mode": "capture"
    },
    {
      "name": "rays-ray-fan",
      "source": "file",
      "filePath": "%CANARY_REPO_LIGHTRO%/decoded/bundles/IMG_0011/_gh/rays_ray-fan.png",
      "tolerance": 0.05,
      "description": "the 81 rays arriving at one pixel",
      "mode": "capture"
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_LIGHTRO%/tests/slop/05_rays.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 90000
    },
    {
      "type": "GrasshopperSetSlider",
      "nickname": "RayModeIndex",
      "value": 2
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    },
    {
      "type": "GrasshopperSetSlider",
      "nickname": "RayModeIndex",
      "value": 9
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    },
    {
      "type": "GrasshopperSetSlider",
      "nickname": "RayModeIndex",
      "value": 14
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    },
    {
      "type": "GrasshopperSetSlider",
      "nickname": "RayModeIndex",
      "value": 18
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    }
  ],
  "asserts": [
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": "Slop build succeeded"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "FATAL",
      "description": ""
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "not found",
      "description": ""
    },
    {
      "type": "PanelContains",
      "nickname": "RaysModes",
      "text": "flys-eye",
      "description": "the mode list is published"
    },
    {
      "type": "PanelContains",
      "nickname": "RaysInfo",
      "text": "rays arriving",
      "description": "last mode reported its measurement"
    },
    {
      "type": "PanelContains",
      "nickname": "RaysFilePath",
      "text": "rays_ray-fan",
      "description": "the mode wrote its PNG"
    }
  ],
  "keepOpenOnFailure": true,
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_LIGHTRO%/tests/slop/05_rays.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_LIGHTRO repo; check that repo out and point %CANARY_REPO_LIGHTRO% at it (see workloads/tokens.json)"
    }
  ]
}