{
 "workload": "rhino",
 "setup": {
  "file": "fixtures/bristle_slop_loader.gh",
  "viewport": {
   "width": 800,
   "height": 600,
   "projection": "Perspective",
   "displayMode": "Shaded"
  },
  "commands": [],
  "scene": null,
  "backend": "",
  "canvas": null,
  "vlm": null
 },
 "runMode": "shared",
 "recording": "",
 "checkpoints": [
  {
   "name": "canvas-state",
   "source": "viewport",
   "atTimeMs": 0,
   "tolerance": 0.0,
   "description": "showcase canvas (save-only)",
   "mode": "capture",
   "camera": null,
   "stabilizeMs": null
  }
 ],
 "keepOpenOnFailure": false,
 "name": "bristle-06-regions-showcase",
 "description": "R1 showcase: market analyzed twice with regions.points_per_side 8 vs 32 - AnalysisParams provably bite (region counts differ); palette boundaries from the same job. PREREQ: live R2 engine.",
 "actions": [
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": false
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Cleanup",
   "value": false
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 2000
  },
  {
   "type": "GrasshopperSetPanelText",
   "nickname": "JsonPath",
   "text": "%CANARY_REPO_BRISTLE%/tests/slop/06_bristle_regions_showcase.json"
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Build",
   "value": true
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 30000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Run",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "StateA",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 120000
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "StateB",
   "text": "done",
   "mode": "equals",
   "timeoutMs": 120000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 3000
  },
  {
   "type": "GrasshopperSetToggle",
   "nickname": "Harvest",
   "value": true
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "RegLogA",
   "text": "fetched",
   "mode": "contains",
   "timeoutMs": 20000
  },
  {
   "type": "WaitForGrasshopperPanel",
   "nickname": "RegLogB",
   "text": "fetched",
   "mode": "contains",
   "timeoutMs": 20000
  },
  {
   "type": "WaitForGrasshopperSolution",
   "timeoutMs": 5000
  }
 ],
 "asserts": [
  {
   "type": "PanelDoesNotContain",
   "nickname": "ConnStatus",
   "text": "OFFLINE",
   "description": "engine reachable"
  },
  {
   "type": "PanelsDiffer",
   "nickname": "RegLogA",
   "text": "RegLogB",
   "description": "points_per_side 8 vs 32 must change the region decomposition - AnalysisParams bite end-to-end"
  },
  {
   "type": "PanelContains",
   "nickname": "RegLogA",
   "text": "regions fetched",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "RegLogB",
   "text": "regions fetched",
   "description": ""
  },
  {
   "type": "PanelContains",
   "nickname": "PaletteLog",
   "text": "palette fetched",
   "description": "palette-cluster boundaries arrive as curves"
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "RegLogA",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelDoesNotContain",
   "nickname": "RegLogB",
   "text": "FAILED",
   "description": ""
  },
  {
   "type": "PanelEquals",
   "nickname": "SlopSuccess",
   "text": "True",
   "description": ""
  }
 ],
 "requires": [
  {
   "kind": "plugin",
   "id": "gh:Slop",
   "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
  },
  {
   "kind": "plugin",
   "id": "gh:Bristle",
   "fix": "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
  },
  {
   "kind": "file",
   "path": "%CANARY_REPO_BRISTLE%/tests/slop/06_bristle_regions_showcase.json",
   "fix": "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
  }
 ]
}
