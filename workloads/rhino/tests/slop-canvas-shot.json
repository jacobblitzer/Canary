{
    "name":  "slop-canvas-shot",
    "workload":  "rhino",
    "description":  "SCRATCH canvas render of 10_bristle_seeds_studio (generated by scripts/slop-canvas-shot.ps1). Not a gate test; absent from suites.",
    "setup":  {
                  "file":  "fixtures/bristle_slop_loader.gh",
                  "viewport":  {
                                   "width":  800,
                                   "height":  600,
                                   "projection":  "Perspective",
                                   "displayMode":  "Shaded"
                               },
                  "commands":  [

                               ],
                  "scene":  null,
                  "backend":  "",
                  "canvas":  null,
                  "vlm":  null
              },
    "runMode":  "shared",
    "recording":  "",
    "checkpoints":  [

                    ],
    "actions":  [
                    {
                        "type":  "WaitForGrasshopperSolution",
                        "timeoutMs":  5000
                    },
                    {
                        "type":  "GrasshopperSetToggle",
                        "nickname":  "Build",
                        "value":  false
                    },
                    {
                        "type":  "GrasshopperSetToggle",
                        "nickname":  "Cleanup",
                        "value":  true
                    },
                    {
                        "type":  "WaitForGrasshopperSolution",
                        "timeoutMs":  5000
                    },
                    {
                        "type":  "GrasshopperSetToggle",
                        "nickname":  "Cleanup",
                        "value":  false
                    },
                    {
                        "type":  "WaitForGrasshopperSolution",
                        "timeoutMs":  2000
                    },
                    {
                        "type":  "GrasshopperSetPanelText",
                        "nickname":  "JsonPath",
                        "text":  "%CANARY_REPO_BRISTLE%/tests/slop/10_bristle_seeds_studio.json"
                    },
                    {
                        "type":  "GrasshopperSetToggle",
                        "nickname":  "Build",
                        "value":  true
                    },
                    {
                        "type":  "WaitForGrasshopperSolution",
                        "timeoutMs":  60000
                    },
                    {
                        "type":  "GrasshopperCanvasImage",
                        "path":  "%CANARY_REPO_CANARY%/workloads/rhino/results/canvas-shots/AFTER-10_bristle_seeds_studio.png",
                        "zoom":  1,
                        "padding":  25
                    }
                ],
    "asserts":  [
                    {
                        "type":  "PanelEquals",
                        "nickname":  "SlopSuccess",
                        "text":  "True",
                        "description":  "definition built before the canvas was rendered"
                    }
                ],
    "keepOpenOnFailure":  false,
    "requires":  [
        {
            "kind":  "plugin",
            "id":  "gh:Slop",
            "fix":  "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
        },
        {
            "kind":  "plugin",
            "id":  "gh:Bristle",
            "fix":  "install the Bristle yak package, or on a dev machine build %CANARY_REPO_BRISTLE% Bristle.GH (net48) and register its output folder in Grasshopper Developer Settings"
        },
        {
            "kind":  "file",
            "path":  "%CANARY_REPO_BRISTLE%/tests/slop/10_bristle_seeds_studio.json",
            "fix":  "this test loads a Slop definition from the CANARY_REPO_BRISTLE repo; check that repo out and point %CANARY_REPO_BRISTLE% at it (see workloads/tokens.json)"
        }
    ]
}
