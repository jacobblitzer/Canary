{
  "name": "cpig-kin-06-fork-bound-static",
  "workload": "rhino",
  "description": "kin-06 Fork Bound + Static Equilibrium — load the leading-link fork with 3 §11 body_geometry bindings (lowerLink + upperLink + carrier proxy boxes), solve via ConstrainedManifoldSolver under a 20 N wheel load, render through Preview Diagram in Skeleton + Bodies mode (Display Mode = 2). Phase 4.C body-binding demo.",
  "runMode": "shared",
  "setup": {
    "file": "fixtures/cpig_slop_loader.gh",
    "viewport": {
      "projection": "Perspective",
      "displayMode": "Shaded",
      "floating": true,
      "width": 800,
      "height": 600
    },
    "commands": [],
    "vlm": {
      "provider": "ollama",
      "model": "gemma4:e2b"
    },
    "vlmDescription": "A four-bar fork mechanism shown at static equilibrium under load — three solid shaded bodies are visible (two parallel horizontal arms and a vertical wheel carrier on the right), all snapped onto the kinematic skeleton via Phase 4 body-binding. The skeleton frame triads and pivot circles are drawn at 50% alpha behind the solid bodies. The coil-over spring between the column and upper link shows visible compression below the design pose."
  },
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_CPIG%/research/slop_tests/kin_06_fork_bound_static.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 60000
    }
  ],
  "checkpoints": [
    {
      "name": "front",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Front",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "top",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Top",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "right",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Right",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "persp",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Perspective",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    }
  ],
  "asserts": [
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "FATAL"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "!!!"
    },
    {
      "type": "PanelEquals",
      "nickname": "Converged",
      "text": "True"
    },
    {
      "type": "PanelContains",
      "nickname": "Report",
      "text": "iter"
    }
  ],
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "plugin",
      "id": "gh:CPig Kinematics",
      "fix": "install the CPig yak package, or on a dev machine build %CANARY_REPO_CPIG% CPig.Kinematics.Grasshopper (net48)"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_CPIG%/research/slop_tests/kin_06_fork_bound_static.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_CPIG repo; check that repo out and point %CANARY_REPO_CPIG% at it (see workloads/tokens.json)"
    }
]
}