{
  "name": "lightro-06-effects",
  "workload": "rhino",
  "description": "06 Effects \u2014 the four output components at once on IMG_0011: synthetic depth of field, anaglyph stereo, depth layers and the depth relief, each on its own placement rectangle so the viewport shows them side by side.",
  "setup": {
    "file": "fixtures/lightro_slop_loader.gh",
    "viewport": {
      "width": 1200,
      "height": 700,
      "projection": "Top",
      "displayMode": "Shaded"
    },
    "commands": []
  },
  "runMode": "shared",
  "checkpoints": [
    {
      "name": "effects-dof",
      "source": "file",
      "panelNickname": "DofFilePath",
      "tolerance": 0.05,
      "description": "synthetic depth of field, focus alpha -1.9, aperture 1.5 (beyond the camera's real pupil)",
      "mode": "capture"
    },
    {
      "name": "effects-anaglyph",
      "source": "file",
      "panelNickname": "StereoFilePath",
      "tolerance": 0.05,
      "description": "red/cyan anaglyph at eye separation 2.0 via depth warping",
      "mode": "capture"
    },
    {
      "name": "effects-viewport",
      "source": "viewport",
      "tolerance": 0.1,
      "description": "Rhino Top viewport: DOF / stereo / layer stack / relief laid out side by side at x = 0 / 12 / 24 / 36",
      "mode": "capture"
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "C:/Repos/Lightro/tests/slop/06_effects.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 180000
    },
    {
      "type": "RunCommand",
      "command": "_-SetView _World _Top _Enter"
    },
    {
      "type": "RunCommand",
      "command": "_-Zoom _All _Extents _Enter"
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 10000
    }
  ],
  "asserts": [
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": "Slop build succeeded"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "FATAL",
      "description": ""
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "not found",
      "description": ""
    },
    {
      "type": "PanelContains",
      "nickname": "DofInfo",
      "text": "aperture",
      "description": "depth of field rendered"
    },
    {
      "type": "PanelContains",
      "nickname": "StereoInfo",
      "text": "anaglyph",
      "description": "stereo rendered"
    },
    {
      "type": "PanelContains",
      "nickname": "LayersInfo",
      "text": "depth bands",
      "description": "layers emitted"
    },
    {
      "type": "PanelContains",
      "nickname": "ReliefInfo",
      "text": "relief",
      "description": "relief mesh emitted"
    }
  ],
  "keepOpenOnFailure": true
}