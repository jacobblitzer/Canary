{
  "name": "cpig-kin-07-pendulum-bound-animated",
  "workload": "rhino",
  "description": "kin-07 Pendulum Bound + Forward Dynamics + Animate Bound — load pendulum with the rod body bound to pendulum-rod.stl, integrate 2.0s of free-swing dynamics, scrub Animate Bound to step 500 (~ mid-arc), render through Preview Diagram in Skeleton + Bodies mode. Phase 4.C body-binding-animation demo.",
  "runMode": "shared",
  "setup": {
    "file": "fixtures/cpig_slop_loader.gh",
    "viewport": {
      "projection": "Perspective",
      "displayMode": "Shaded",
      "floating": true,
      "width": 800,
      "height": 600
    },
    "commands": [],
    "vlm": {
      "provider": "ollama",
      "model": "gemma4:e2b"
    },
    "vlmDescription": "A thin solid cylindrical rod pendulum, mid-swing, hanging from a fixed revolute pivot at the world origin. The rod renders as a shaded cylinder rotated partway down from its initial 10° offset position. The kinematic skeleton (pivot circle, axis triads) is drawn at 50% alpha behind the solid rod body."
  },
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_CPIG%/research/slop_tests/kin_07_pendulum_bound_animated.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 90000
    }
  ],
  "checkpoints": [
    {
      "name": "front",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Front",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "top",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Top",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "right",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Right",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    },
    {
      "name": "persp",
      "atTimeMs": 5000,
      "tolerance": 0.02,
      "viewport": {
        "projection": "Perspective",
        "displayMode": "Shaded",
        "floating": true,
        "width": 800,
        "height": 600
      }
    }
  ],
  "asserts": [
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "FATAL"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "!!!"
    },
    {
      "type": "PanelEquals",
      "nickname": "Completed",
      "text": "True"
    },
    {
      "type": "PanelEquals",
      "nickname": "StepCount",
      "text": "2001"
    }
  ],
  "requires": [
    {
      "kind": "plugin",
      "id": "gh:Slop",
      "fix": "install the Slop yak package; on a dev machine a Release net48 build ships it to the Drive folder GH loads from - check `canary doctor` output for the location actually in use"
    },
    {
      "kind": "plugin",
      "id": "gh:CPig Kinematics",
      "fix": "install the CPig yak package, or on a dev machine build %CANARY_REPO_CPIG% CPig.Kinematics.Grasshopper (net48)"
    },
    {
      "kind": "file",
      "path": "%CANARY_REPO_CPIG%/research/slop_tests/kin_07_pendulum_bound_animated.json",
      "fix": "this test loads a Slop definition from the CANARY_REPO_CPIG repo; check that repo out and point %CANARY_REPO_CPIG% at it (see workloads/tokens.json)"
    }
]
}