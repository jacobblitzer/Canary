{
  "name": "bristle-15-gh-cluster-seeds",
  "workload": "rhino",
  "description": "GH-SIDE SEED GENERATION studio (keep-open, absent from every suite): one cheap analyze (regions off) computes the palette layer; a GH sample grid reads cluster ids at mm points (engine-side letterbox placement both directions); Point Groups finds contiguous blobs of the picked cluster; blob centroids become UserSeeds (branch = bound group = one region) for a seeded good-quality job whose regions render as fills over the photo. Auto mode cascades job1 -> fetch -> cluster -> job2 -> regions from a single Run1 flip.",
  "runMode": "shared",
  "setup": {
    "file": "fixtures/bristle_slop_loader.gh",
    "viewport": {
      "projection": "Top",
      "displayMode": "Shaded",
      "width": 800,
      "height": 600,
      "floating": true
    },
    "commands": []
  },
  "checkpoints": [
    {
      "name": "gh-cluster-seeds",
      "source": "viewport",
      "atTimeMs": 0,
      "mode": "capture",
      "stabilizeMs": 1500,
      "tolerance": 0.0,
      "viewport": {
        "projection": "Top",
        "displayMode": "Shaded",
        "width": 800,
        "height": 600,
        "floating": true
      },
      "description": "Top view: red centroid dots on the picked palette cluster's blobs, region fills from the seeded job over the photo"
    }
  ],
  "actions": [
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": false
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Cleanup",
      "value": false
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 2000
    },
    {
      "type": "GrasshopperSetPanelText",
      "nickname": "JsonPath",
      "text": "%CANARY_REPO_BRISTLE%/tests/slop/15_bristle_gh_cluster_seeds.json"
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Build",
      "value": true
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 40000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "SlopLog",
      "text": "objects placed",
      "mode": "contains",
      "timeoutMs": 20000
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    },
    {
      "type": "GrasshopperSetToggle",
      "nickname": "Run1",
      "value": true
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "JobState1",
      "text": "done",
      "mode": "equals",
      "timeoutMs": 300000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "JobState2",
      "text": "done",
      "mode": "equals",
      "timeoutMs": 900000
    },
    {
      "type": "WaitForGrasshopperPanel",
      "nickname": "RegionCount",
      "text": "fetched",
      "mode": "contains",
      "timeoutMs": 120000
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 20000
    },
    {
      "type": "SetView",
      "name": "Top"
    },
    {
      "type": "WaitForGrasshopperSolution",
      "timeoutMs": 5000
    }
  ],
  "asserts": [
    {
      "type": "PanelDoesNotContain",
      "nickname": "ConnStatus",
      "text": "OFFLINE",
      "description": "engine reachable"
    },
    {
      "type": "PanelEquals",
      "nickname": "SlopSuccess",
      "text": "True",
      "description": "every component resolved and wired (post-expire-fix this is the real verdict)"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "Fatal error",
      "description": "build callback did not crash"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "Submit2Log",
      "text": "FAILED",
      "description": "the seeded submit accepted the GH centroids as UserSeeds (points_mm path)"
    },
    {
      "type": "PanelContains",
      "nickname": "RegionCount",
      "text": "regions fetched",
      "description": "the seeded job's region tree came home"
    },
    {
      "type": "PanelDoesNotContain",
      "nickname": "SlopLog",
      "text": "not found",
      "description": "no unresolved component names"
    }
  ],
  "keepOpenOnFailure": true
}