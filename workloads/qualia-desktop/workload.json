{
  "name": "qualia-desktop",
  "displayName": "Qualia (Desktop exe)",
  "appPath": "",
  "appArgs": "",
  "agentType": "qualia-cdp",
  "pipeName": "canary-qualia-desktop",
  "startupTimeoutMs": 45000,
  "windowTitle": "Qualia",
  "viewportClass": "",
  "qualiaConfig": {
    "desktop": true,
    "appExePath": "%CANARY_REPO_QUALIA%\\src-tauri\\target\\release\\app.exe",
    "appStartupTimeoutMs": 45000,
    "projectDir": "%CANARY_REPO_QUALIA%",
    "cdpPort": 9224,
    "defaultCanvasWidth": 1280,
    "defaultCanvasHeight": 720,
    "defaultStabilizeMs": 500,
    "readyTimeoutSec": 45,
    "clearLocalStorageOnInit": true
  },
  "requires": [
    {
      "kind": "plugin",
      "id": "js:__canaryWaitForReady",
      "fix": "the Qualia page did not install its Canary hooks (packages/ui/src/canary-hooks.ts) - check the app actually built and is being served, not a stale dist"
    }
  ]
}
